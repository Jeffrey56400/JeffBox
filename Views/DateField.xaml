<UserControl x:Class="TodoApp.Views.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <!-- 日格按钮：Tag 驱动状态（selected=选中蓝底白字，today=蓝色加粗），仅 30 个格子无需更复杂的机制 -->
        <Style x:Key="DayBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Margin="1" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="today">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="selected">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="Field" Click="Field_Click" Cursor="Hand" Height="32" MinWidth="138">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1.4"
                            CornerRadius="8">
                        <ContentPresenter VerticalAlignment="Center" Margin="10,0,10,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" />
                <TextBlock x:Name="ValueText" FontSize="12.5" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextBody}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Popup x:Name="CalPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Placement="Bottom" Margin="0,4,0,0">
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1.2" CornerRadius="12" Padding="8" Margin="0,0,8,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.20" Color="#1A2038" />
                </Border.Effect>
                <StackPanel MinWidth="252">
                    <StackPanel x:Name="QuickRow" Orientation="Horizontal" Margin="2,2,2,8" />
                    <Grid Margin="2,0,2,6">
                        <Button x:Name="PrevBtn" Width="26" Height="26" HorizontalAlignment="Left"
                                Focusable="False" Cursor="Hand" Click="PrevBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSub}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button x:Name="NextBtn" Width="26" Height="26" HorizontalAlignment="Right"
                                Focusable="False" Cursor="Hand" Click="NextBtn_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSub}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <UniformGrid x:Name="WeekHeader" Columns="7" Margin="0,0,0,4" />
                    <UniformGrid x:Name="Days" Columns="7" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
