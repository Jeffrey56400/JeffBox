<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TodoApp"
        xmlns:svc="clr-namespace:TodoApp.Services"
        xmlns:views="clr-namespace:TodoApp.Views"
        Title="JeffBox"
        Width="620" Height="680"
        MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Icon="/app.ico"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSub}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SegCheckedBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <local:LevelIndentConverter x:Key="LevelIndent" />
        <local:LevelScaleConverter x:Key="LevelScale" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />

        <!-- ============ 滚动条（极简细条） ============ -->
        

        

        <!-- ============ 待办卡片 ============ -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                      Opacity="0.10" Color="#3A4160" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Opacity" Value="0.62" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                              Opacity="0.05" Color="#3A4160" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 圆形勾选框（带动画） ============ -->
        <Style x:Key="TodoCheck" TargetType="CheckBox">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Ellipse x:Name="Ring" Width="21" Height="21"
                                     Stroke="{DynamicResource TrackOff}" StrokeThickness="1.6" />
                            <Ellipse x:Name="Fill" Width="21" Height="21"
                                     Fill="{DynamicResource Accent}" Opacity="0" />
                            <Path x:Name="Check" Data="M 6.5,11.2 L 10.2,14.8 L 16,7.5"
                                  Stroke="White" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 小号勾选框（浮层子级快编行） ============ -->
        <Style x:Key="MiniCheck" TargetType="CheckBox" BasedOn="{StaticResource TodoCheck}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="24" Height="24" Background="Transparent">
                            <Ellipse x:Name="Ring" Width="14" Height="14"
                                     Stroke="{DynamicResource TrackOff}" StrokeThickness="1.4" />
                            <Ellipse x:Name="Fill" Width="14" Height="14"
                                     Fill="{DynamicResource Accent}" Opacity="0" />
                            <Path x:Name="Check" Data="M 4.3,7.4 L 6.7,9.8 L 10.6,5"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.13" />
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.10" />
                                            <DoubleAnimation Storyboard.TargetName="Check"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 卡片内文字 ============ -->
        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 删除按钮（悬停卡片时出现） ============ -->
        <Style x:Key="DeleteBtn" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 卡片右侧「›」：展开子任务 / 打开详情 ============ -->
        <Style x:Key="ChevronBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 分段按钮（筛选 / 设置选择） ============ -->
        

        <!-- ============ 主输入框 ============ -->
        <Style x:Key="MainInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                          Opacity="0.20" Color="#5B7CFF" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 添加 / 完成按钮（主色） ============ -->
        

        <!-- ============ 工具栏小按钮 ============ -->
        

        <!-- ============ 优先级选择按钮 ============ -->
        <Style x:Key="PriorityBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Pill}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSub}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 标题栏按钮 ============ -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource TextSub}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 文字按钮 ============ -->
        

        <!-- ============ 进度条 ============ -->
        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource HoverBg}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2.5" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="2.5" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 开关 ============ -->
        <Style x:Key="SwitchCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource TrackOff}" />
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" Color="#3A4160" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="21,0,0,0" Duration="0:0:0.16">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Knob"
                                                                Storyboard.TargetProperty="Margin"
                                                                To="3,0,0,0" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 扁平下拉框 ============ -->
        <Style x:Key="FlatComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="9,6" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ChipBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FlatComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="8"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource TextSub}" StrokeThickness="1.6"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,26,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource Card}" CornerRadius="10" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.16" Color="#3A4160" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 浮层内控件 ============ -->
        

        <Style x:Key="OverlayTitleBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" Padding="0,2">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface2}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="86" />
            <Setter Property="MaxHeight" Value="170" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 创建时的内联详情输入 -->
        <Style x:Key="NewDetailsBox" TargetType="TextBox" BasedOn="{StaticResource NotesBox}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="72" />
            <Setter Property="MaxHeight" Value="140" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <!-- 子任务添加输入框 -->
        <Style x:Key="SubAddBox" TargetType="TextBox" BasedOn="{StaticResource NotesBox}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MaxHeight" Value="80" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="AcceptsReturn" Value="False" />
        </Style>

        <!-- 子任务行内文字编辑框 -->
        <Style x:Key="InlineSubBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBody}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="138" />
            <Setter Property="Language" Value="zh-CN" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ============ 提醒横幅按钮 ============ -->
        <Style x:Key="BannerChipBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#22FFFFFF" CornerRadius="8" Padding="11,5">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="White" Opacity="0.55" />
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BannerCloseBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E9FF" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Width="26" Height="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 浮层子任务快编行 ============ -->
        <DataTemplate x:Key="SubEditRow" DataType="{x:Type local:TodoViewModel}">
            <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="8,3" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Style="{StaticResource MiniCheck}"
                              IsChecked="{Binding IsDone}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Style="{StaticResource InlineSubBox}"
                             Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                             VerticalAlignment="Center" Margin="4,0,4,0" />
                    <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Content="✕" FontSize="10"
                            Click="OverlaySubDelete_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ============ 待办卡片模板（递归：子任务复用同一模板） ============ -->
        <DataTemplate x:Key="TodoCard" DataType="{x:Type local:TodoViewModel}">
            <Border x:Name="CardRoot" Style="{StaticResource CardStyle}" Cursor="Hand"
                    Margin="{Binding Level, Converter={StaticResource LevelIndent}}"
                    MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave"
                    MouseLeftButtonUp="Card_Click">
                <Border.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Level, Converter={StaticResource LevelScale}}"
                                    ScaleY="{Binding Level, Converter={StaticResource LevelScale}}" />
                </Border.LayoutTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 优先级色条 -->
                        <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                   VerticalAlignment="Stretch" Margin="2,6,10,6">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Priority}" Value="1">
                                            <Setter Property="Fill" Value="#3DD598" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="2">
                                            <Setter Property="Fill" Value="#FFB627" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="3">
                                            <Setter Property="Fill" Value="#FF5A5F" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <CheckBox Grid.Column="1" Style="{StaticResource TodoCheck}"
                                  IsChecked="{Binding IsDone}" />

                        <StackPanel Grid.Column="2" Margin="6,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardText}" Text="{Binding Text}" />

                            <!-- 截止时间 / 子任务进度胶囊 -->
                            <StackPanel Orientation="Horizontal" Margin="1,7,0,1">
                                <Border x:Name="DueChip" CornerRadius="5" Padding="7,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource DueChipBg}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource DueChipFg}" />
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DueText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource OverdueBg}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource OverdueFg}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="11" Height="11" VerticalAlignment="Center">
                                            <Ellipse Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                     StrokeThickness="1.3" />
                                            <Line X1="5.5" Y1="3" X2="5.5" Y2="5.6"
                                                  Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                  StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            <Line X1="5.5" Y1="5.6" X2="7.6" Y2="4.4"
                                                  Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                  StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Grid>
                                        <TextBlock Text="{Binding DueText}" FontSize="11"
                                                   Margin="5,0,0,0" VerticalAlignment="Center" />
                                        <Path Data="M3.1,7.4 L2.0,8.9 L8.0,8.9 L6.9,7.4 L6.9,4.7 C6.9,3.1 5.9,1.9 5.0,1.9 C4.1,1.9 3.1,3.1 3.1,4.7 Z"
                                              Width="10" Height="10" Stretch="Uniform" Margin="6,1,0,0"
                                              VerticalAlignment="Center"
                                              Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Remind}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="5" Background="{DynamicResource SubPillBg}" Padding="7,3" Margin="6,0,0,0"
                                        Visibility="{Binding HasSubs, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="11" Height="11" VerticalAlignment="Center">
                                            <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5"
                                                       Stroke="{DynamicResource SubPillFg}" StrokeThickness="1.3" />
                                            <Line X1="4.5" Y1="2.6" X2="4.5" Y2="6.4"
                                                  Stroke="{DynamicResource SubPillFg}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Grid>
                                        <TextBlock Text="{Binding SubProgress}" FontSize="11"
                                                   Foreground="{DynamicResource SubPillFg}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="3" Style="{StaticResource ChevronBtn}"
                                Click="ChevronBtn_Click" ToolTip="{Binding ChevronTip}">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="11" />
                        </Button>

                        <Button Grid.Column="4" Style="{StaticResource DeleteBtn}"
                                Content="✕" Click="DeleteBtn_Click"
                                ToolTip="{Binding [Delete], Source={x:Static svc:Loc.Instance}}" />

                        <!-- 悬停 500ms 预览弹窗（可点击打开详情，不拦截下方卡片以外的操作） -->
                        <Popup x:Name="PreviewPopup" AllowsTransparency="True" StaysOpen="True"
                               PlacementTarget="{Binding ElementName=CardRoot}" Placement="Bottom"
                               HorizontalOffset="-6" VerticalOffset="6" PopupAnimation="Fade"
                               Grid.Column="0" Grid.ColumnSpan="5">
                            <Border Background="#EE262B3B" CornerRadius="10" Padding="14,12"
                                    MaxWidth="340" Cursor="Hand"
                                    MouseEnter="PreviewPopup_Enter" MouseLeave="PreviewPopup_Leave"
                                    MouseLeftButtonUp="PreviewPopup_Click">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#10131F" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="13"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PreviewDetails}" Foreground="#C4C9DC"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="132" />
                                    <Border Background="{DynamicResource Card}" CornerRadius="6" Padding="2"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding FirstImage, Converter={StaticResource NullToCollapsed}}">
                                        <Image Source="{Binding FirstImage}" MaxHeight="130" Stretch="Uniform" />
                                    </Border>
                                    <Border Height="1" Background="#3A3F55" Margin="0,10,0,0" />
                                    <TextBlock Text="{Binding PreviewMeta}" Foreground="#8F96B3"
                                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding [ClickToView], Source={x:Static svc:Loc.Instance}}"
                                               Foreground="#9BA3D8" FontSize="10.5"
                                               Margin="0,6,0,0" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- 子任务（完整卡片，递归模板） -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Children}"
                                  ItemTemplate="{DynamicResource TodoCard}"
                                  Margin="2,2,0,0"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======== 标题栏 ======== -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource Accent}">
                    <TextBlock Text="✓" Foreground="White" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="AppTitleTb" Text="JeffBox" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBody}"
                           Margin="9,0,0,0" VerticalAlignment="Center" />
                <Border x:Name="HotkeyPill" CornerRadius="5" Background="{DynamicResource Pill}"
                        Padding="7,2" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="HotkeyPillText" Text="Ctrl+Alt+T"
                               FontSize="10.5" Foreground="{DynamicResource TextSub}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="SettingsBtn" Style="{StaticResource CaptionBtn}"
                        ToolTip="设置" Click="SettingsBtn_Click">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="12" />
                </Button>
                <Button Style="{StaticResource CaptionBtn}" Content="—"
                        x:Name="MinBtn" Click="MinBtn_Click" />
                <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}"
                        ToolTip="最大化 / 还原" Click="MaxBtn_Click">
                    <TextBlock x:Name="MaxBtnIcon" FontFamily="{StaticResource IconFont}"
                               Text="&#xE922;" FontSize="11" />
                </Button>
                <Button x:Name="WinCloseBtn" Style="{StaticResource CloseBtn}" Content="✕"
                        ToolTip="关闭" Click="CloseBtn_Click" />
            </StackPanel>
        </Grid>

        <!-- ======== 导航栏 ======== -->
        <Border Grid.Row="1" Grid.Column="0" Width="52"
                Background="{DynamicResource Pill}">
            <StackPanel VerticalAlignment="Top" Margin="0,12,0,0">
                <RadioButton x:Name="NavTodo" Style="{StaticResource NavBtn}"
                             GroupName="nav" IsChecked="True" Checked="NavTodo_Checked"
                             ToolTip="{Binding [NavTodo], Source={x:Static svc:Loc.Instance}}"
                             Content="&#xE73A;" />
                <RadioButton x:Name="NavMd" Style="{StaticResource NavBtn}"
                             GroupName="nav" Checked="NavMd_Checked"
                             ToolTip="{Binding [NavMd], Source={x:Static svc:Loc.Instance}}"
                             Content="&#xE70B;" />
                <RadioButton x:Name="NavLaunch" Style="{StaticResource NavBtn}"
                             GroupName="nav" Checked="NavLaunch_Checked"
                             ToolTip="{Binding [NavLaunch], Source={x:Static svc:Loc.Instance}}"
                             Content="&#xE71D;" />
            </StackPanel>
        </Border>

        <!-- ======== 主内容区 ======== -->
        <Grid Grid.Row="1" Grid.Column="1">
        <Grid x:Name="TodoView">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======== 页眉 ======== -->
        <StackPanel Grid.Row="0" Margin="24,10,24,14">
            <TextBlock x:Name="HeaderTitleTb" Text="今日待办" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}" />
            <TextBlock x:Name="DateText" FontSize="12.5"
                       Foreground="{DynamicResource TextSub}" Margin="1,5,0,0" />
        </StackPanel>

        <!-- ======== 输入区（标题 + 可展开详情） ======== -->
        <StackPanel Grid.Row="1" Margin="20,0,20,14">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="PriorityBtn" Style="{StaticResource PriorityBtn}"
                        Click="PriorityBtn_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PriorityDot" Width="9" Height="9" Fill="#C9CEE0" />
                        <TextBlock x:Name="PriorityLabel" Text="无" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid Grid.Column="2">
                    <TextBox x:Name="InputBox" Style="{StaticResource MainInput}"
                             KeyDown="InputBox_KeyDown" VerticalAlignment="Center" />
                    <TextBlock x:Name="InputHintTb" Text="想做点什么？按 Enter 快速添加"
                               Foreground="{DynamicResource TextFaint}" FontSize="13"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="4" x:Name="DetailsToggleBtn" Style="{StaticResource ChipBtn}"
                        Content="更多" Click="DetailsToggleBtn_Click" VerticalAlignment="Center" />

                <Button Grid.Column="6" x:Name="AddBtn" Style="{StaticResource AddBtn}"
                        Content="添加" Click="AddBtn_Click" VerticalAlignment="Center" />
            </Grid>

            <!-- 完整创建卡：与详情浮层同构，一步创建 -->
            <Border x:Name="NewDetailsPanel" Visibility="Collapsed" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1.4"
                    CornerRadius="12" Padding="12,10" Margin="0,0,0,2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                      Opacity="0.08" Color="#3A4160" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="NewDetailsLabelTb" Style="{StaticResource DetailLabel}"
                                   Margin="2,0,0,6" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="NewInsertImageBtn" Style="{StaticResource ChipBtn}"
                                    Content="插入图片" Click="NewInsertImageBtn_Click" Margin="0,0,6,0" />
                            <Button x:Name="NewPreviewBtn" Style="{StaticResource ChipBtn}"
                                    Content="预览" Click="NewPreviewBtn_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid x:Name="NewEditArea">
                            <TextBox x:Name="NewDetailsBox" Style="{StaticResource NewDetailsBox}"
                                     KeyDown="NewDetailsBox_KeyDown" PreviewKeyDown="NotesBox_PreviewKeyDown" />
                            <TextBlock x:Name="NewDetailsHint" Text="添加详细内容（可选，支持 Markdown，可直接粘贴图片）"
                                       Foreground="{DynamicResource TextFaint}" FontSize="12"
                                       IsHitTestVisible="False" Margin="11,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewDetailsBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Border x:Name="NewPreviewHost" Visibility="Collapsed"
                                Background="{DynamicResource Surface2}" CornerRadius="9" Padding="10,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
                                <StackPanel x:Name="NewPreviewPanel" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="NewDueLabelTb" Style="{StaticResource DetailLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="NewDatePicker" Grid.Column="0"
                                    Style="{StaticResource FlatDatePicker}" />
                        <ComboBox x:Name="NewHourCombo" Grid.Column="2"
                                  Style="{StaticResource FlatCombo}" Width="64" />
                        <ComboBox x:Name="NewMinCombo" Grid.Column="4"
                                  Style="{StaticResource FlatCombo}" Width="64" />
                        <Button x:Name="NewNoDueBtn" Grid.Column="6" Style="{StaticResource GhostBtn}"
                                VerticalAlignment="Center" Click="NewNoDueBtn_Click" />
                    </Grid>

                    <Grid Margin="2,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="NewRemindToggle" Grid.Column="0"
                                  Style="{StaticResource SwitchCheck}" VerticalAlignment="Center" />
                        <TextBlock x:Name="NewRemindTextTb" Grid.Column="2" FontSize="12.5"
                                   Foreground="{DynamicResource TextBody}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="NewPriorityLabelTb" Style="{StaticResource DetailLabel}" />
                    <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="NewP0" Style="{StaticResource SegButton}"
                                         GroupName="newPriority" Checked="NewP_Checked" />
                            <RadioButton x:Name="NewP1" Style="{StaticResource SegButton}"
                                         GroupName="newPriority" Checked="NewP_Checked" />
                            <RadioButton x:Name="NewP2" Style="{StaticResource SegButton}"
                                         GroupName="newPriority" Checked="NewP_Checked" />
                            <RadioButton x:Name="NewP3" Style="{StaticResource SegButton}"
                                         GroupName="newPriority" Checked="NewP_Checked" />
                        </UniformGrid>
                    </Border>

                    <TextBlock x:Name="NewSubsLabelTb" Style="{StaticResource DetailLabel}" />
                    <ItemsControl x:Name="NewSubList" ItemTemplate="{StaticResource SubEditRow}" />
                    <Grid Margin="0,2,0,4">
                        <TextBox x:Name="NewSubBox" Style="{StaticResource SubAddBox}"
                                 KeyDown="NewSubBox_KeyDown" />
                        <TextBlock x:Name="NewSubHintTb"
                                   Foreground="{DynamicResource TextFaint}" FontSize="12"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewSubBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ======== 筛选器 + 一键展开/收起 ======== -->
        <Grid Grid.Row="2" Margin="20,0,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Pill}"
                    CornerRadius="10" Padding="3">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="FilterAll" Style="{StaticResource SegButton}" GroupName="filter"
                                 IsChecked="True" Content="全部" Checked="Filter_Checked" />
                    <RadioButton x:Name="FilterActive" Style="{StaticResource SegButton}" GroupName="filter"
                                 Content="待办" Checked="Filter_Checked" />
                    <RadioButton x:Name="FilterDone" Style="{StaticResource SegButton}" GroupName="filter"
                                 Content="已完成" Checked="Filter_Checked" />
                </UniformGrid>
            </Border>
            <Button x:Name="ToggleAllBtn" Grid.Column="2" Style="{StaticResource ChipBtn}"
                    Content="全部收起" Click="ToggleAllBtn_Click" Visibility="Collapsed"
                    VerticalAlignment="Stretch" />
        </Grid>

        <!-- ======== 列表 ======== -->
        <Grid Grid.Row="3" Margin="20,0,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ListItems" ItemTemplate="{StaticResource TodoCard}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource Card}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270"
                                          Opacity="0.10" Color="#3A4160" />
                    </Border.Effect>
                    <TextBlock Text="✓" FontSize="34" Foreground="#B9C3F5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitleTb" Text="这里空空如也" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSub}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="EmptyHintTb" Text="在上方输入一条待办，开始规划今天" FontSize="12"
                           Foreground="{DynamicResource TextFaint}"
                           HorizontalAlignment="Center" Margin="0,5,0,0" />
                <TextBlock x:Name="EmptyHint2Tb" Text="单击卡片可设置截止时间、提醒与子任务" FontSize="11"
                           Foreground="{DynamicResource TextFaint}"
                           HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- ======== 底栏 ======== -->
        <StackPanel Grid.Row="4" Margin="20,14,20,16">
            <ProgressBar x:Name="DoneBar" Style="{StaticResource SlimProgress}"
                         Minimum="0" Maximum="100" Value="0" />
            <Grid Margin="2,9,2,0">
                <TextBlock x:Name="DoneText" Text="已完成 0 / 0" FontSize="12"
                           Foreground="{DynamicResource TextSub}" VerticalAlignment="Center" />
                <Button x:Name="ClearDoneBtn" Style="{StaticResource GhostBtn}"
                        Content="清除已完成" HorizontalAlignment="Right"
                        Visibility="Collapsed" Click="ClearDoneBtn_Click" />
            </Grid>
        </StackPanel>

        </Grid><!-- /TodoView -->

        <views:MdToolView x:Name="MdView" Visibility="Collapsed" />
        <views:LaunchToolView x:Name="LaunchView" Visibility="Collapsed" />
        </Grid><!-- /主内容区 -->

        <!-- ======== 到期提醒横幅 ======== -->
        <Grid x:Name="BannerHost" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed"
              VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Border x:Name="BannerCard" CornerRadius="14" Padding="16,11" MinWidth="330" Opacity="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5B7CFF" />
                        <GradientStop Color="#8B5CF6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="#3A3E6E" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BannerShift" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                        <Ellipse Stroke="White" StrokeThickness="1.6" />
                        <Line X1="10" Y1="5.5" X2="10" Y2="10" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="10" Y1="10" X2="13.5" Y2="8.2" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BannerTitleTb" Text="待办提醒" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="BannerMsg" Text="" Foreground="#E6E9FF" FontSize="11.5"
                                   MaxWidth="230" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="BannerViewBtn" Grid.Column="2" Style="{StaticResource BannerChipBtn}"
                            Content="查看" Click="BannerViewBtn_Click" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Style="{StaticResource BannerCloseBtn}"
                            Content="✕" Click="BannerCloseBtn_Click" VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ======== 详情浮层（实时编辑，任意层级） ======== -->
        <Grid x:Name="DetailOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border x:Name="OverlayMask" Background="#73161C2E" Opacity="0"
                    MouseLeftButtonUp="OverlayMask_MouseLeftButtonUp" />
            <Border x:Name="OverlayCard" Width="382" CornerRadius="16" Background="{DynamicResource Card}"
                    Padding="22,18" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="OverlayScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.30" Color="#1A2038" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="DetailTitleTb" Text="待办详情" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSub}"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource GhostBtn}" Content="✕" FontSize="11"
                                    HorizontalAlignment="Right" Click="DetailCloseBtn_Click" />
                        </Grid>

                        <TextBlock x:Name="BreadcrumbTb" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextSub}" Margin="1,8,0,0"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />

                        <TextBox x:Name="DetailTitleBox" Style="{StaticResource OverlayTitleBox}"
                                 Margin="0,6,0,0"
                                 Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <!-- 详细内容：标签 + 工具栏 -->
                        <Grid>
                            <TextBlock x:Name="DetailsLabelTb" Style="{StaticResource DetailLabel}"
                                       Margin="2,16,0,6" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,10,0,0">
                                <Button x:Name="InsertImageBtn" Style="{StaticResource ChipBtn}"
                                        Content="插入图片" Click="InsertImageBtn_Click" Margin="0,0,6,0" />
                                <Button x:Name="ImportMdBtn" Style="{StaticResource ChipBtn}"
                                        Content="导入 MD" Click="ImportMdBtn_Click" Margin="0,0,6,0" />
                                <Button x:Name="PreviewBtn" Style="{StaticResource ChipBtn}"
                                        Content="预览" Click="PreviewBtn_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <TextBox x:Name="DetailNotesBox" Style="{StaticResource NotesBox}"
                                     Text="{Binding Details, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     PreviewKeyDown="NotesBox_PreviewKeyDown" />
                            <Border x:Name="NotesPreviewHost" Visibility="Collapsed"
                                    Background="{DynamicResource Surface2}" CornerRadius="9" Padding="10,8"
                                    MinHeight="86" MaxHeight="170">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="NotesPreviewPanel" />
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="DueLabelTb" Style="{StaticResource DetailLabel}" Text="截止时间" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DueDatePicker" Grid.Column="0"
                                        Style="{StaticResource FlatDatePicker}"
                                        SelectedDateChanged="DueDatePicker_SelectedDateChanged" />
                            <ComboBox x:Name="HourCombo" Grid.Column="2"
                                      Style="{StaticResource FlatCombo}" Width="64"
                                      SelectionChanged="TimeCombo_SelectionChanged" />
                            <ComboBox x:Name="MinCombo" Grid.Column="4"
                                      Style="{StaticResource FlatCombo}" Width="64"
                                      SelectionChanged="TimeCombo_SelectionChanged" />
                            <Button x:Name="NoDeadlineBtn" Grid.Column="6" Style="{StaticResource GhostBtn}"
                                    Content="无期限" VerticalAlignment="Center"
                                    Click="ClearDueBtn_Click" />
                        </Grid>

                        <TextBlock x:Name="RemindLabelTb" Style="{StaticResource DetailLabel}" Text="提醒" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="RemindToggle" Grid.Column="0"
                                      Style="{StaticResource SwitchCheck}" VerticalAlignment="Center"
                                      IsChecked="{Binding Remind, Mode=TwoWay}" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="RemindTextTb" Text="到点提醒我" FontSize="13"
                                           Foreground="{DynamicResource TextBody}" />
                                <TextBlock x:Name="RemindHintTb" Text="到达截止时间时弹出提醒（需保持应用开启）"
                                           FontSize="11" Foreground="{DynamicResource TextFaint}"
                                           Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="PriorityLabelTb" Style="{StaticResource DetailLabel}" Text="优先级" />
                        <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                                HorizontalAlignment="Left">
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="DetailP0" Style="{StaticResource SegButton}"
                                             GroupName="detailPriority" Content="无" Checked="DetailP_Checked" />
                                <RadioButton x:Name="DetailP1" Style="{StaticResource SegButton}"
                                             GroupName="detailPriority" Content="低" Checked="DetailP_Checked" />
                                <RadioButton x:Name="DetailP2" Style="{StaticResource SegButton}"
                                             GroupName="detailPriority" Content="中" Checked="DetailP_Checked" />
                                <RadioButton x:Name="DetailP3" Style="{StaticResource SegButton}"
                                             GroupName="detailPriority" Content="高" Checked="DetailP_Checked" />
                            </UniformGrid>
                        </Border>

                        <!-- 子任务（实时增删，点卡片可进入子任务自己的详情） -->
                        <TextBlock x:Name="SubtasksLabelTb" Style="{StaticResource DetailLabel}" Text="子任务" />
                        <ItemsControl x:Name="OverlaySubList" ItemTemplate="{StaticResource SubEditRow}" />
                        <Grid Margin="0,2,0,0">
                            <TextBox x:Name="AddSubtaskBox" Style="{StaticResource SubAddBox}"
                                     KeyDown="AddSubtaskBox_KeyDown" />
                            <TextBlock x:Name="AddSubHintTb" Text="添加子任务，按 Enter 确认"
                                       Foreground="{DynamicResource TextFaint}" FontSize="12"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Margin="12,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AddSubtaskBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock x:Name="DetailMetaText" FontSize="11"
                                   Foreground="{DynamicResource TextFaint}" Margin="2,18,0,0" />
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,12,0,14" />
                        <Grid>
                            <Button x:Name="DetailDeleteBtn" Style="{StaticResource GhostBtn}"
                                    Content="删除" HorizontalAlignment="Left"
                                    Click="DetailDeleteBtn_Click" VerticalAlignment="Center" />
                            <Button x:Name="DetailDoneBtn" Style="{StaticResource AddBtn}"
                                    Content="完成" HorizontalAlignment="Right"
                                    Click="DetailDoneBtn_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ======== 设置浮层 ======== -->
        <Grid x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border x:Name="SettingsMask" Background="#73161C2E" Opacity="0"
                    MouseLeftButtonUp="SettingsMask_MouseLeftButtonUp" />
            <Border x:Name="SettingsCard" Width="360" CornerRadius="16" Background="{DynamicResource Card}"
                    Padding="22,18" Margin="0,16" VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsScale" ScaleX="0.96" ScaleY="0.96" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.30" Color="#1A2038" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 标题与关闭按钮固定在滚动区外：无论滚到哪里都可见，也不会被滚动条压住 -->
                    <Grid Grid.Row="0" Margin="0,0,8,10">
                        <TextBlock x:Name="SettingsTitleTb" Text="设置" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource GhostBtn}" Content="✕" FontSize="11"
                                HorizontalAlignment="Right" Click="SettingsCloseBtn_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="556" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- 右侧 8px 让位给覆盖式滚动条，滑块不压「停用」等按钮 -->
                        <StackPanel Margin="0,0,8,0">
                    <TextBlock x:Name="LangLabelTb" Style="{StaticResource SettingsLabel}" Text="语言" />
                    <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="LangZh" Style="{StaticResource SegButton}"
                                         GroupName="setLang" Content="简体中文" Checked="LangZh_Checked" />
                            <RadioButton x:Name="LangEn" Style="{StaticResource SegButton}"
                                         GroupName="setLang" Content="English" Checked="LangEn_Checked" />
                        </UniformGrid>
                    </Border>

                    <TextBlock x:Name="ThemeLabelTb" Style="{StaticResource SettingsLabel}" Text="外观" />
                    <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="SetThemeLight" Style="{StaticResource SegButton}"
                                         GroupName="setTheme" Content="浅色" Checked="SetThemeLight_Checked" />
                            <RadioButton x:Name="SetThemeDark" Style="{StaticResource SegButton}"
                                         GroupName="setTheme" Content="深色" Checked="SetThemeDark_Checked" />
                        </UniformGrid>
                    </Border>

                    <TextBlock x:Name="CloseBehaviorLabelTb" Style="{StaticResource SettingsLabel}" Text="关闭方式" />
                    <Border Background="{DynamicResource Pill}" CornerRadius="9" Padding="3"
                            HorizontalAlignment="Left">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="CloseTrayRadio" Style="{StaticResource SegButton}"
                                         GroupName="setClose" Content="最小化到托盘" Checked="CloseTrayRadio_Checked" />
                            <RadioButton x:Name="CloseExitRadio" Style="{StaticResource SegButton}"
                                         GroupName="setClose" Content="直接退出" Checked="CloseExitRadio_Checked" />
                        </UniformGrid>
                    </Border>

                    <TextBlock x:Name="AutoStartLabelTb" Style="{StaticResource SettingsLabel}" Text="开机自启动" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AutoStartToggle" Grid.Column="0"
                                  Style="{StaticResource SwitchCheck}" VerticalAlignment="Center"
                                  Checked="AutoStartToggle_Changed" Unchecked="AutoStartToggle_Changed" />
                        <TextBlock x:Name="AutoStartHintTb" Grid.Column="2" Text="开机后自动在系统托盘静默运行"
                                   FontSize="11.5" Foreground="{DynamicResource TextSub}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock x:Name="HotkeyLabelTb" Style="{StaticResource SettingsLabel}" Text="全局快捷键" />
                    <StackPanel>
                        <views:HotkeyBox x:Name="HkMain" />
                        <views:HotkeyBox x:Name="HkTodo" Margin="0,8,0,0" />
                        <views:HotkeyBox x:Name="HkMd" Margin="0,8,0,0" />
                        <views:HotkeyBox x:Name="HkLaunch" Margin="0,8,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="MdAssocLabelTb" Style="{StaticResource SettingsLabel}" Text="MD 文件关联" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="MdAssocToggle" Grid.Column="0"
                                  Style="{StaticResource SwitchCheck}" VerticalAlignment="Center"
                                  Checked="MdAssocToggle_Changed" Unchecked="MdAssocToggle_Changed" />
                        <TextBlock x:Name="MdAssocToggleTb" Grid.Column="2" FontSize="11.5"
                                   Foreground="{DynamicResource TextSub}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,12" />
                    <TextBlock x:Name="SettingsAboutTb" Text="JeffBox v1.0.0 · 数据仅保存在本机"
                               FontSize="11" Foreground="{DynamicResource TextFaint}" />
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
